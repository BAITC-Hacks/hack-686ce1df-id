# Run from the repository root. Never commit .env, source data or artifacts.
# Production uses one complete run. Empty value keeps health.data_ready=false.
AML_RUN_DIR=
# Artificial data ONLY; cannot be combined with AML_RUN_DIR.
AML_FIXTURE_MODE=false
AML_FRONTEND_ORIGIN=http://localhost:5173
AML_FRONTEND_DIST=frontend/dist

# Direction D uses OpenAI; empty key/model keeps the local fallback available.
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_TOOL_CALLS=3

# Optional Docker Compose settings. No .env is required for the fixture demo.
APP_PORT=8000
APP_MEMORY_LIMIT=1g
APP_CPUS=2.0
# Only for compose.artifacts.yaml: existing completed run, relative to repo or absolute.
AML_ARTIFACTS_DIR=./artifacts/example-run
