  "components": {
    "schemas": {
      "AICheck": {
        "properties": {
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "args": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Args"
          },
          "result": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Result"
          },
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool",
          "args",
          "result",
          "evidence_id"
        ],
        "title": "AICheck"
      },
      "AIClaim": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "evidence_ids"
        ],
        "title": "AIClaim"
      },
      "AIResponse": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "1.0",
            "title": "Contract Version",
            "default": "1.0"
          },
          "run_id": {
            "type": "string",
            "minLength": 1,
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "fallback"
            ],
            "title": "Status"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/AIClaim"
            },
            "type": "array",
            "title": "Claims"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/AICheck"
            },
            "type": "array",
            "title": "Checks"
          },
          "fallback_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "contract_version",
          "run_id",
          "status",
          "summary",
          "claims",
          "limitations",
          "checks",
          "fallback_reason"
        ],
        "title": "AIResponse"
      },
      "ClusterHypothesis": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "basis_rule_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Basis Rule Ids"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "basis_rule_ids",
          "limitations"
        ],
        "title": "ClusterHypothesis"
      },
      "ClusterRecord": {
        "properties": {
          "cluster_id": {
            "type": "string",
            "minLength": 1,
            "title": "Cluster Id"
          },
          "component_id": {
            "type": "string",
            "minLength": 1,
            "title": "Component Id"
          },
          "gids": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "title": "Gids"
          },
          "hypothesis": {
            "$ref": "#/components/schemas/ClusterHypothesis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cluster_id",
          "component_id",
          "gids",
          "hypothesis"
        ],
        "title": "ClusterRecord"
      },
      "ClusterResponse": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "1.0",
            "title": "Contract Version",
            "default": "1.0"
          },
          "run_id": {
            "type": "string",
            "minLength": 1,
            "title": "Run Id"
          },
          "cluster": {
            "$ref": "#/components/schemas/ClusterRecord"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "contract_version",
          "run_id",
          "cluster"
        ],
        "title": "ClusterResponse"
      },
      "ClustersResponse": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "1.0",
            "title": "Contract Version",
            "default": "1.0"
          },
          "run_id": {
            "type": "string",
            "minLength": 1,
            "title": "Run Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ClusterRecord"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "contract_version",
          "run_id",
          "items"
        ],
        "title": "ClustersResponse"
      },
      "EdgeRecord": {
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "title": "Source"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "title": "Target"
          },
          "amount_kzt": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
            "title": "Amount Kzt"
          },
          "tx_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Tx Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "target",
          "amount_kzt",
          "tx_count"
        ],
        "title": "EdgeRecord"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error",
          "run_id"
        ],
        "title": "ErrorResponse"
      },
      "Evidence": {
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "title": "Rule Id"
          },
          "metric": {
            "type": "string",
            "minLength": 1,
            "title": "Metric"
          },
          "operator": {
            "type": "string",
            "enum": [
              "gt",
              "gte",
              "lt",
              "lte",
              "eq"
            ],
            "title": "Operator"
          },
          "actual": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ],
            "title": "Threshold"
          },
          "passed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rule_id",
          "metric",
          "operator",
          "actual",
          "threshold",
          "passed"
