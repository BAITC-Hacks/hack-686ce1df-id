        "summary": "Get Graph",
        "operationId": "get_graph_api_graph_get",
        "parameters": [
          {
            "name": "gid",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
